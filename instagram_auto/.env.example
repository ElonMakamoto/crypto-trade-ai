# Google AI Studio key (https://aistudio.google.com/apikey) — writes headlines/captions
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Branding
BRAND_HANDLE=@yourpage
ACCENT_COLOR=#FFD400

# News
NEWS_COUNTRY=US
NEWS_LANGUAGE=en
POST_LANGUAGE=English

# Instagram — option A: username/password
IG_BACKEND=instagrapi
IG_USERNAME=
IG_PASSWORD=

# Instagram — option B: official Graph API (Business/Creator account)
# IG_BACKEND=graph
# IG_ACCESS_TOKEN=
# IG_USER_ID=
# PUBLIC_MEDIA_BASE_URL=https://your-site.example/media

# both | post | reel
POST_MODE=both
INTERVAL_HOURS=5
REEL_SECONDS=8
